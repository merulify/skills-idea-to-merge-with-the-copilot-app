---
// Bookmarks component (scaffold).
//
// The markup below renders during the static build. The dynamic behavior —
// adding a bookmark, generating a short slug, and persisting to the browser —
// must run ONLY in the client-side <script> boundary at the bottom of this
// file. Astro runs that script in the browser, never during the build, so
// browser-only APIs are safe there.
//
// You will implement the behavior in Step 3.
---
<form id="add-bookmark">
  <div class="field">
    <label for="title">Bookmark title</label>
    <input
      id="title"
      name="title"
      type="text"
      maxlength="120"
      autocomplete="off"
      spellcheck="false"
      placeholder="Example"
    />
  </div>
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button id="submit-bookmark" type="submit">Add bookmark</button>
  <button id="cancel-edit" type="button" hidden>Cancel edit</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  import {
    BOOKMARKS_STORAGE_KEY,
    createBookmarkSlug,
    formatBookmarkEntry,
    normalizeBookmarkTitle,
    normalizeBookmarkUrl,
    parseStoredBookmarks,
    type Bookmark,
    updateBookmarkUrl
  } from './bookmark-helpers';

  const form = document.getElementById('add-bookmark');
  const titleInput = document.getElementById('title');
  const urlInput = document.getElementById('url');
  const submitButton = document.getElementById('submit-bookmark');
  const cancelEditButton = document.getElementById('cancel-edit');
  const bookmarkList = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearAllButton = document.getElementById('clear-all');

  let editingSlug: string | null = null;

  const bookmarks = loadBookmarks();
  renderBookmarks(bookmarks);

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    if (!(urlInput instanceof HTMLInputElement)) {
      return;
    }

    urlInput.setCustomValidity('');
    const normalizedUrl = normalizeBookmarkUrl(urlInput.value);
    if (!normalizedUrl) {
      urlInput.setCustomValidity('Enter a valid URL.');
      urlInput.reportValidity();
      return;
    }

    const normalizedTitle = normalizeBookmarkTitle(
      titleInput instanceof HTMLInputElement ? titleInput.value : ''
    );

    if (editingSlug) {
      const nextBookmarks = updateBookmarkUrl(
        bookmarks,
        editingSlug,
        normalizedUrl,
        normalizedTitle
      );
      bookmarks.splice(0, bookmarks.length, ...nextBookmarks);
    } else {
      const usedSlugs = new Set(bookmarks.map((bookmark) => bookmark.slug));
      let slug = createBookmarkSlug();
      while (usedSlugs.has(slug)) {
        slug = createBookmarkSlug();
      }

      bookmarks.unshift({
        url: normalizedUrl,
        slug,
        ...(normalizedTitle ? { title: normalizedTitle } : {})
      });
    }

    saveBookmarks(bookmarks);
    renderBookmarks(bookmarks);
    resetFormState();
  });

  cancelEditButton?.addEventListener('click', () => {
    resetFormState();
  });

  clearAllButton?.addEventListener('click', () => {
    if (!confirm('Clear all saved bookmarks?')) {
      return;
    }

    bookmarks.length = 0;
    saveBookmarks(bookmarks);
    renderBookmarks(bookmarks);
    resetFormState();
  });

  function resetFormState() {
    editingSlug = null;
    form?.reset();

    if (submitButton instanceof HTMLButtonElement) {
      submitButton.textContent = 'Add bookmark';
    }
    if (cancelEditButton instanceof HTMLButtonElement) {
      cancelEditButton.hidden = true;
    }
  }

  function beginEditingBookmark(bookmark: Bookmark) {
    if (!(urlInput instanceof HTMLInputElement) || !(titleInput instanceof HTMLInputElement)) {
      return;
    }

    editingSlug = bookmark.slug;
    titleInput.value = bookmark.title ?? '';
    urlInput.value = bookmark.url;
    urlInput.focus();

    if (submitButton instanceof HTMLButtonElement) {
      submitButton.textContent = 'Save changes';
    }
    if (cancelEditButton instanceof HTMLButtonElement) {
      cancelEditButton.hidden = false;
    }
  }

  function loadBookmarks() {
    try {
      return parseStoredBookmarks(localStorage.getItem(BOOKMARKS_STORAGE_KEY));
    } catch (error) {
      console.warn('Unable to load bookmarks from localStorage.', error);
      return [];
    }
  }

  function saveBookmarks(nextBookmarks) {
    try {
      localStorage.setItem(BOOKMARKS_STORAGE_KEY, JSON.stringify(nextBookmarks));
    } catch (error) {
      console.warn('Unable to save bookmarks to localStorage.', error);
    }
  }

  function renderBookmarks(nextBookmarks) {
    if (!(bookmarkList instanceof HTMLUListElement)) {
      return;
    }

    bookmarkList.textContent = '';
    for (const bookmark of nextBookmarks) {
      const row = document.createElement('li');
      row.className = 'bookmark';

      const title = bookmark.title?.trim();
      const titleText = document.createElement('span');
      titleText.className = 'bookmark-title';
      titleText.textContent = title ?? 'Untitled';
      titleText.title = title ?? bookmark.url;

      const urlLink = document.createElement('a');
      urlLink.className = 'url';
      urlLink.href = bookmark.url;
      urlLink.target = '_blank';
      urlLink.rel = 'noreferrer noopener';
      urlLink.textContent = bookmark.url;

      const separator = document.createElement('span');
      separator.className = 'separator';
      separator.textContent = ' :: ';

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;
      slug.setAttribute('aria-label', formatBookmarkEntry(bookmark));

      const editButton = document.createElement('button');
      editButton.type = 'button';
      editButton.className = 'edit';
      editButton.textContent = 'Edit';
      editButton.setAttribute('aria-label', `Edit ${bookmark.slug}`);
      editButton.addEventListener('click', () => {
        beginEditingBookmark(bookmark);
      });

      const copyButton = document.createElement('button');
      copyButton.type = 'button';
      copyButton.className = 'copy';
      copyButton.textContent = 'Copy';
      copyButton.setAttribute('aria-label', `Copy ${bookmark.slug}`);
      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          copyButton.textContent = 'Copied';
          setTimeout(() => {
            copyButton.textContent = 'Copy';
          }, 1200);
        } catch (error) {
          console.warn('Unable to copy bookmark slug.', error);
        }
      });

      if (title) {
        row.append(titleText, separator, urlLink, separator.cloneNode(true), slug, editButton, copyButton);
      } else {
        row.append(urlLink, separator, slug, editButton, copyButton);
      }
      bookmarkList.append(row);
    }

    const hasBookmarks = nextBookmarks.length > 0;
    if (emptyState instanceof HTMLElement) {
      emptyState.hidden = hasBookmarks;
    }
    if (listHeader instanceof HTMLElement) {
      listHeader.hidden = !hasBookmarks;
    }
  }
</script>
