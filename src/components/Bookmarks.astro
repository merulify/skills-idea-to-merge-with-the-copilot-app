---
// Bookmarks component (scaffold).
//
// The markup below renders during the static build. The dynamic behavior —
// adding a bookmark, generating a short slug, and persisting to the browser —
// must run ONLY in the client-side <script> boundary at the bottom of this
// file. Astro runs that script in the browser, never during the build, so
// browser-only APIs are safe there.
//
// You will implement the behavior in Step 3.
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  import {
    BOOKMARKS_STORAGE_KEY,
    createBookmarkSlug,
    formatBookmarkEntry,
    normalizeBookmarkUrl,
    parseStoredBookmarks
  } from './bookmark-helpers';

  const form = document.getElementById('add-bookmark');
  const urlInput = document.getElementById('url');
  const bookmarkList = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearAllButton = document.getElementById('clear-all');

  const bookmarks = loadBookmarks();
  renderBookmarks(bookmarks);

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    if (!(urlInput instanceof HTMLInputElement)) {
      return;
    }

    urlInput.setCustomValidity('');
    const normalizedUrl = normalizeBookmarkUrl(urlInput.value);
    if (!normalizedUrl) {
      urlInput.setCustomValidity('Enter a valid URL.');
      urlInput.reportValidity();
      return;
    }

    const usedSlugs = new Set(bookmarks.map((bookmark) => bookmark.slug));
    let slug = createBookmarkSlug();
    while (usedSlugs.has(slug)) {
      slug = createBookmarkSlug();
    }

    bookmarks.unshift({ url: normalizedUrl, slug });
    saveBookmarks(bookmarks);
    renderBookmarks(bookmarks);
    form.reset();
  });

  clearAllButton?.addEventListener('click', () => {
    if (!confirm('Clear all saved bookmarks?')) {
      return;
    }

    bookmarks.length = 0;
    saveBookmarks(bookmarks);
    renderBookmarks(bookmarks);
  });

  function loadBookmarks() {
    try {
      return parseStoredBookmarks(localStorage.getItem(BOOKMARKS_STORAGE_KEY));
    } catch {
      return [];
    }
  }

  function saveBookmarks(nextBookmarks) {
    try {
      localStorage.setItem(BOOKMARKS_STORAGE_KEY, JSON.stringify(nextBookmarks));
    } catch {
      // Ignore write errors to keep the UI responsive (e.g. private mode or quota).
    }
  }

  function renderBookmarks(nextBookmarks) {
    if (!(bookmarkList instanceof HTMLUListElement)) {
      return;
    }

    bookmarkList.textContent = '';
    for (const bookmark of nextBookmarks) {
      const row = document.createElement('li');
      row.className = 'bookmark';

      const urlLink = document.createElement('a');
      urlLink.className = 'url';
      urlLink.href = bookmark.url;
      urlLink.target = '_blank';
      urlLink.rel = 'noreferrer noopener';
      urlLink.textContent = bookmark.url;

      const separator = document.createElement('span');
      separator.className = 'separator';
      separator.textContent = ' :: ';

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;
      slug.setAttribute('aria-label', formatBookmarkEntry(bookmark));

      row.append(urlLink, separator, slug);
      bookmarkList.append(row);
    }

    const hasBookmarks = nextBookmarks.length > 0;
    if (emptyState instanceof HTMLElement) {
      emptyState.hidden = hasBookmarks;
    }
    if (listHeader instanceof HTMLElement) {
      listHeader.hidden = !hasBookmarks;
    }
  }
</script>
